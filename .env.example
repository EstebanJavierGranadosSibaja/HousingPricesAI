# HousingPricesAI — Environment Configuration
# Copy this file to .env and adjust values as needed.
# .env is loaded automatically by the app (requires python-dotenv).

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------

# "ollama"  — use local Ollama server (recommended)
# "mock"    — always use template-based explanation (no LLM needed)
LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Ollama Settings (only used when LLM_PROVIDER=ollama)
# ---------------------------------------------------------------------------

# URL of the local Ollama server
OLLAMA_HOST=http://localhost:11434

# Model to use for explanation generation.
#   qwen3:8b     — default, high quality, requires ~6 GB VRAM / 8 GB RAM
#   llama3.2:3b  — lighter option, suitable for CPU-only or 4 GB RAM
OLLAMA_MODEL=qwen3:8b

# Maximum seconds to wait for Ollama to respond before falling back to template
OLLAMA_TIMEOUT=30
